.head{padding:6rpx 4rpx 20rpx}
.head-title{font-size:34rpx;font-weight:700}
.head-sub{display:block;font-size:22rpx;color:#8b95a5;margin-top:8rpx}
.rem-card{background:#fff;border-radius:18rpx;padding:24rpx;margin-bottom:16rpx;box-shadow:0 4rpx 18rpx rgba(31,39,51,.04)}
.rem-main{flex:1;min-width:0;padding-right:16rpx}
.rem-name{font-size:27rpx;font-weight:600;line-height:1.45}
.rem-kind{display:block;font-size:21rpx;color:#8b95a5;margin-top:6rpx}
.rem-time{display:block;font-size:23rpx;color:#3b82f6;margin-top:4rpx}
.rem-right{display:flex;flex-direction:column;align-items:flex-end;gap:10rpx}
.rem-status{font-size:22rpx;color:#1d9b58}
.rem-status.overdue{color:#e55555}
.rem-actions{display:flex;gap:28rpx;margin-top:16rpx;padding-top:14rpx;border-top:2rpx solid #f4f6fb}
.rem-act{font-size:22rpx;color:#3b82f6}
.rem-act.danger{color:#e55555}
.empty{text-align:center;padding:70rpx 0 30rpx;color:#8b95a5}
.empty-btn{width:360rpx;margin:26rpx auto 0}
.tip{font-size:20rpx;color:#9aa4b1;line-height:1.6;margin-top:26rpx;padding:0 6rpx}