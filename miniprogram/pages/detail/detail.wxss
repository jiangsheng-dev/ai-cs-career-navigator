.detail-name{font-size:34rpx;font-weight:700;line-height:1.4}
.detail-tags{display:flex;align-items:center;flex-wrap:wrap;margin-top:12rpx}
.detail-stars{color:#f2a03d;font-size:22rpx;letter-spacing:2rpx}
.detail-why{display:block;font-size:24rpx;color:#5b6675;margin-top:14rpx;line-height:1.6}
.info-card{margin-top:18rpx}
.info-row{display:flex;padding:12rpx 0;border-bottom:2rpx solid #f4f6fb}
.info-row:last-child{border-bottom:0}
.info-k{width:170rpx;color:#8b95a5;font-size:23rpx;flex-shrink:0}
.info-v{flex:1;font-size:23rpx;line-height:1.6}
.node{background:#fff;border:2rpx solid #e9edf4;border-radius:16rpx;padding:20rpx;margin-bottom:12rpx}
.node-on{border-color:#3b82f6;background:#f5f9ff}
.node-kind{font-size:26rpx;font-weight:600}
.node-days{font-size:22rpx;color:#3b82f6}
.node-date{display:block;font-size:22rpx;color:#8b95a5;margin-top:4rpx}
.pick-row{padding:16rpx 0;border-bottom:2rpx solid #f4f6fb}
.pick-k{font-size:25rpx;color:#5b6675}
.pick-v{font-size:25rpx;color:#3b82f6}
.adv-row{display:flex;gap:10rpx}
.adv{padding:6rpx 16rpx;border-radius:999rpx;background:#f1f3f7;color:#5b6675;font-size:21rpx}
.adv-on{background:#eaf2ff;color:#3b82f6;font-weight:600}
.btn-gap{margin-top:16rpx}
.big-gap{margin-top:30rpx}
.tip{font-size:20rpx;color:#9aa4b1;line-height:1.6;margin-top:22rpx;padding:0 6rpx}