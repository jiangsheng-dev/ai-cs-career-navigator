.head{padding:6rpx 4rpx 18rpx}
.head-title{font-size:34rpx;font-weight:700}
.sync{font-size:20rpx;color:#1d9b58;background:#e9f8ef;padding:4rpx 14rpx;border-radius:999rpx}
.head-sub{display:block;font-size:22rpx;color:#8b95a5;margin-top:8rpx}
.search{margin:10rpx 0 16rpx}
.chips{display:flex;gap:12rpx;margin-bottom:18rpx}
.chip{padding:8rpx 26rpx;border-radius:999rpx;background:#fff;color:#5b6675;font-size:24rpx;border:2rpx solid #e9edf4}
.chip-on{background:#eaf2ff;border-color:#3b82f6;color:#3b82f6;font-weight:600}
.item{background:#fff;border-radius:18rpx;padding:24rpx;margin-bottom:16rpx;box-shadow:0 4rpx 18rpx rgba(31,39,51,.04)}
.item-name{font-size:28rpx;font-weight:600;line-height:1.45;flex:1;padding-right:16rpx}
.item-days{font-size:22rpx;color:#3b82f6;flex-shrink:0}
.item-tags{display:flex;align-items:center;flex-wrap:wrap;margin-top:10rpx}
.item-stars{font-size:20rpx;color:#f2a03d;letter-spacing:2rpx}
.item-org{display:block;font-size:21rpx;color:#8b95a5;margin-top:8rpx}
.item-foot{margin-top:12rpx}
.item-next{font-size:21rpx;color:#5b6675}
.item-arrow{font-size:21rpx;color:#3b82f6}